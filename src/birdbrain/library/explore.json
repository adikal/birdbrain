{
  "doc": "Wander for a while, keeping clear of the basket, then look around.",
  "params": {},
  "budget": 30,
  "expect": "true",
  "body": [
    {
      "if": "known(basket)",
      "then": [
        {
          "call": "wander",
          "args": {
            "seconds": 6,
            "avoid": "basket"
          }
        }
      ],
      "else": [
        {
          "call": "wander",
          "args": {
            "seconds": 6
          }
        }
      ]
    },
    {
      "call": "look_around"
    }
  ]
}
