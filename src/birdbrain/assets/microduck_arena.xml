<mujoco model="birdbrain_microduck_arena">
  <compiler angle="degree" autolimits="true"/>
  <option timestep="0.005" gravity="0 0 -9.81" integrator="implicitfast"/>

  <visual>
    <global azimuth="135" elevation="-25"/>
    <headlight ambient="0.35 0.35 0.35" diffuse="0.7 0.7 0.7"/>
  </visual>

  <default>
    <joint damping="0.8" armature="0.015"/>
    <geom friction="0.9 0.02 0.001" solref="0.01 1"/>
    <default class="duck_visual">
      <geom contype="0" conaffinity="0" group="2"/>
    </default>
    <default class="duck_collision">
      <geom rgba="1 0.78 0.08 1" density="550" group="3"/>
    </default>
    <default class="position_motor">
      <position kp="18" kv="1.5" ctrllimited="true" ctrlrange="-0.7 0.7"/>
    </default>
  </default>

  <asset>
    <texture name="floor_texture" type="2d" builtin="checker"
             rgb1="0.16 0.20 0.22" rgb2="0.21 0.26 0.28"
             width="256" height="256"/>
    <material name="floor_material" texture="floor_texture" texrepeat="8 8"
              reflectance="0.08"/>
    <material name="duck_yellow" rgba="1 0.78 0.08 1"/>
    <material name="duck_orange" rgba="1 0.34 0.04 1"/>
    <material name="duck_black" rgba="0.025 0.025 0.03 1"/>
    <material name="wall_material" rgba="0.36 0.43 0.46 1"/>
    <material name="blue_toy" rgba="0.08 0.34 0.92 1"/>
    <material name="red_toy" rgba="0.92 0.12 0.10 1"/>
    <material name="charge_material" rgba="0.14 0.82 0.52 0.65"/>
  </asset>

  <worldbody>
    <light name="key_light" pos="0 0 3" dir="0 0 -1" directional="true"/>
    <geom name="floor" type="plane" size="2 2 0.1" material="floor_material"/>

    <geom name="wall_north" type="box" pos="0 2 0.18" size="2.05 0.05 0.18"
          material="wall_material"/>
    <geom name="wall_south" type="box" pos="0 -2 0.18" size="2.05 0.05 0.18"
          material="wall_material"/>
    <geom name="wall_east" type="box" pos="2 0 0.18" size="0.05 1.95 0.18"
          material="wall_material"/>
    <geom name="wall_west" type="box" pos="-2 0 0.18" size="0.05 1.95 0.18"
          material="wall_material"/>

    <geom name="charging_pad" type="cylinder" pos="-1.35 -1.35 0.008"
          size="0.28 0.008" material="charge_material" contype="0" conaffinity="0"/>
    <site name="charging_zone" type="cylinder" pos="-1.35 -1.35 0.02"
          size="0.26 0.01" rgba="0.1 1 0.55 0.3"/>

    <body name="blue_block" pos="0.85 0.55 0.07">
      <freejoint name="blue_block_free"/>
      <geom name="blue_block_geom" type="box" size="0.07 0.07 0.07"
            mass="0.12" material="blue_toy"/>
    </body>

    <body name="red_ball" pos="0.75 -0.65 0.07">
      <freejoint name="red_ball_free"/>
      <geom name="red_ball_geom" type="sphere" size="0.07"
            mass="0.09" material="red_toy"/>
    </body>

    <body name="microduck" pos="0 0 0.23">
      <freejoint name="root_free"/>
      <site name="imu" pos="0 0 0.02" size="0.01"/>

      <geom name="torso_collision" class="duck_collision" type="ellipsoid"
            size="0.14 0.10 0.11" mass="0.55"/>
      <geom name="torso_visual" class="duck_visual" type="ellipsoid"
            size="0.142 0.102 0.112" material="duck_yellow"/>

      <geom name="left_wing" class="duck_visual" type="ellipsoid"
            pos="-0.015 0.105 0.01" euler="12 0 -8" size="0.105 0.018 0.065"
            material="duck_yellow"/>
      <geom name="right_wing" class="duck_visual" type="ellipsoid"
            pos="-0.015 -0.105 0.01" euler="-12 0 8" size="0.105 0.018 0.065"
            material="duck_yellow"/>

      <body name="head" pos="0.095 0 0.115">
        <joint name="neck_yaw" type="hinge" axis="0 0 1" range="-40 40"/>
        <geom name="head_collision" class="duck_collision" type="ellipsoid"
              size="0.082 0.072 0.078" mass="0.16"/>
        <geom name="head_visual" class="duck_visual" type="ellipsoid"
              size="0.084 0.074 0.08" material="duck_yellow"/>
        <geom name="beak" class="duck_visual" type="box" pos="0.103 0 -0.006"
              size="0.055 0.046 0.021" material="duck_orange"/>
        <geom name="left_eye" class="duck_visual" type="sphere"
              pos="0.055 0.066 0.035" size="0.012" material="duck_black"/>
        <geom name="right_eye" class="duck_visual" type="sphere"
              pos="0.055 -0.066 0.035" size="0.012" material="duck_black"/>
        <site name="gaze" pos="0.17 0 0" size="0.008" rgba="0.1 0.9 1 0.7"/>
      </body>

      <body name="left_leg" pos="0 0.072 -0.075">
        <joint name="left_hip" type="hinge" axis="0 1 0" range="-35 35"/>
        <geom name="left_leg_geom" type="capsule" fromto="0 0 0 0 0 -0.125"
              size="0.018" mass="0.045" material="duck_orange"/>
        <body name="left_foot" pos="0 0 -0.125">
          <joint name="left_ankle" type="hinge" axis="0 1 0" range="-30 30"/>
          <geom name="left_foot_geom" type="box" pos="0.035 0 -0.018"
                size="0.068 0.04 0.018" mass="0.04" material="duck_orange"/>
        </body>
      </body>

      <body name="right_leg" pos="0 -0.072 -0.075">
        <joint name="right_hip" type="hinge" axis="0 1 0" range="-35 35"/>
        <geom name="right_leg_geom" type="capsule" fromto="0 0 0 0 0 -0.125"
              size="0.018" mass="0.045" material="duck_orange"/>
        <body name="right_foot" pos="0 0 -0.125">
          <joint name="right_ankle" type="hinge" axis="0 1 0" range="-30 30"/>
          <geom name="right_foot_geom" type="box" pos="0.035 0 -0.018"
                size="0.068 0.04 0.018" mass="0.04" material="duck_orange"/>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <position name="neck_motor" joint="neck_yaw" kp="8" kv="0.8"
              ctrllimited="true" ctrlrange="-0.7 0.7"/>
    <position name="left_hip_motor" class="position_motor" joint="left_hip"/>
    <position name="left_ankle_motor" class="position_motor" joint="left_ankle"/>
    <position name="right_hip_motor" class="position_motor" joint="right_hip"/>
    <position name="right_ankle_motor" class="position_motor" joint="right_ankle"/>
  </actuator>

  <sensor>
    <framepos name="duck_position" objtype="body" objname="microduck"/>
    <framequat name="duck_orientation" objtype="body" objname="microduck"/>
    <gyro name="duck_gyro" site="imu"/>
    <accelerometer name="duck_accelerometer" site="imu"/>
    <jointpos name="neck_angle" joint="neck_yaw"/>
    <jointpos name="left_hip_angle" joint="left_hip"/>
    <jointpos name="right_hip_angle" joint="right_hip"/>
  </sensor>
</mujoco>
